      }
    ],
    "script": "lotj.afk = false"
  },
  {
    "name": "afk",
    "patterns": [
      {
        "pattern": "You are now afk.",
        "type": "exactMatch"
      },
      {
        "pattern": "You must turn off AFK first! Type AFK to toggle it off.",
        "type": "exactMatch"
      }

[
  {
    "name": "clickable_changes",
    "patterns": [
      {
        "pattern": "^\\( {0,3}(\\d+)\\).+on.+by.+$",
        "type": "regex"
      },
      {
        "pattern": "^.*[Cc]hanges\\s*( {0,3}\\d+)\\'*.*$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "clickable_mail",
    "patterns": [
      {
        "pattern": "^ID\\s*\\|\\s*(?<sender>SENDER|FROM)\\s*\\|\\s*(?:RECIPIENT|TO)\\s*\\|\\s*SUBJECT\\s*$",
        "type": "regex"
      }
    ]
  },
